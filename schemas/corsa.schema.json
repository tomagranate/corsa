{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"tools": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"command": {
						"type": "string",
						"minLength": 1
					},
					"args": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"cwd": {
						"type": "string"
					},
					"env": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "string"
						}
					},
					"cleanup": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"description": {
						"type": "string"
					},
					"healthCheck": {
						"type": "object",
						"properties": {
							"url": {
								"type": "string"
							},
							"interval": {
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							},
							"retries": {
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": ["url"],
						"additionalProperties": false
					},
					"ui": {
						"type": "object",
						"properties": {
							"label": {
								"type": "string"
							},
							"url": {
								"type": "string"
							}
						},
						"required": ["label", "url"],
						"additionalProperties": false
					},
					"dependsOn": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"interactive": {
						"type": "boolean"
					}
				},
				"required": ["name", "command"],
				"additionalProperties": false
			}
		},
		"home": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"title": {
					"type": "string"
				},
				"titleFont": {
					"type": "string",
					"enum": ["tiny", "block", "shade", "slick", "huge", "grid", "pallet"]
				},
				"titleAlign": {
					"type": "string",
					"enum": ["left", "center"]
				}
			},
			"additionalProperties": false
		},
		"mcp": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				}
			},
			"additionalProperties": false
		},
		"processes": {
			"type": "object",
			"properties": {
				"cleanupOrphans": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"ui": {
			"type": "object",
			"properties": {
				"sidebarPosition": {
					"type": "string",
					"enum": ["left", "right"]
				},
				"horizontalTabPosition": {
					"type": "string",
					"enum": ["top", "bottom"]
				},
				"widthThreshold": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"theme": {
					"type": "string"
				},
				"maxLogLines": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 9007199254740991
				},
				"showTabNumbers": {
					"type": "boolean"
				},
				"showLineNumbers": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "string",
							"const": "auto"
						}
					]
				}
			},
			"additionalProperties": false
		}
	},
	"required": ["tools"],
	"additionalProperties": false,
	"title": "corsa config",
	"description": "Configuration schema for corsa.config.toml"
}
